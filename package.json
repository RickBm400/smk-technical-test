{
  "name": "smk-technical-test",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all -p dev:backend dev:frontend",
    "dev:backend": "cd backend && pnpm dev",
    "dev:frontend": "cd frontend && pnpm dev",
    "install:all": "cd frontend && pnpm install && cd ../backend && pnpm install",
    "test": "npm-run-all test:backend test:frontend",
    "test:backend": "cd backend && pnpm test",
    "test:frontend": "cd frontend && pnpm test",
    "lint": "npm-run-all lint:backend lint:frontend",
    "lint:backend": "cd backend && pnpm lint",
    "lint:frontend": "cd frontend && pnpm lint",
    "build": "npm-run-all build:backend build:frontend",
    "build:backend": "cd backend && pnpm build",
    "build:frontend": "cd frontend && pnpm build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
