# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=csvmanager
POSTGRES_PORT=5432

# Backend
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=24h

# Frontend URL(s) - comma-separated list of allowed CORS origins
# Examples:
#   Local dev only:     http://localhost:5173
#   Multiple origins:   http://localhost:5173,http://localhost:5174
#   Docker + local:     http://localhost:5173,http://172.17.0.1:5173
#   Production:         https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=http://localhost:5173
